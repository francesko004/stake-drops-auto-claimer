{
  "manifest_version": 3,
  "name": "Stake Auto-Claim",
  "version": "1.1.1",
  "description": "Production-ready automated bonus drop claimer for Stake with real-time StakeCruncher monitoring and smart threshold filters.",
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://stake.com/*",
    "https://*.stake.com/*",
    "http://stake.com/*",
    "http://*.stake.com/*",
    "https://stake.us/*",
    "https://*.stake.us/*",
    "http://stake.us/*",
    "http://*.stake.us/*",
    "https://stake.bet/*",
    "https://*.stake.bet/*",
    "https://stake.games/*",
    "https://*.stake.games/*",
    "https://stakecruncher.com/*",
    "https://*.stakecruncher.com/*",
    "http://stakecruncher.com/*",
    "http://*.stakecruncher.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://stakecruncher.com/*",
        "https://*.stakecruncher.com/*",
        "http://stakecruncher.com/*",
        "http://*.stakecruncher.com/*"
      ],
      "js": [
        "content/stakecruncher-monitor.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://stake.com/*",
        "https://*.stake.com/*",
        "http://stake.com/*",
        "http://*.stake.com/*",
        "https://stake.us/*",
        "https://*.stake.us/*",
        "http://stake.us/*",
        "http://*.stake.us/*",
        "https://stake.bet/*",
        "https://*.stake.bet/*",
        "https://stake.games/*",
        "https://*.stake.games/*"
      ],
      "js": [
        "content/stake-automator.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}